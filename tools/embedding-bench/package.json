{
  "name": "embedding-bench",
  "private": true,
  "description": "Configurable Transformers.js retrieval-quality and runtime benchmark for agent-qa embedding models.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build-corpus": "node src/corpus.ts",
    "calibrate-tau-lex": "node src/tau-lex.ts",
    "convert-floor": "node src/convert-floor.ts",
    "bench": "node src/report.ts",
    "bench:list": "node src/report.ts --list",
    "bench:validate": "node src/report.ts --validate",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "@huggingface/transformers": "4.2.0",
    "@vostride/agent-qa-eval": "workspace:*",
    "@vostride/agent-qa-knowledge-local": "workspace:*",
    "@vostride/agent-qa-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "~24.12.2",
    "typescript": "~6.0.3",
    "vitest": "~4.1.5"
  }
}
