+# agent-qa Configuration
+
+# File discovery and project settings
+workspace:
+  testMatch:
+    - tests/**/*.yaml
+  suiteMatch:
+    - suites/**/*.suite.yaml
+  hooksFile: hooks.yaml
+  envFile: .env
+  secretsFile: .env.secrets.local
+# Optional: ignore archived or generated tests.
+  # testPathIgnore:
+  #   - tests/archive/**/*.yaml
+
+# Infrastructure services (dashboard, MCP, cache, auth state, logging)
+services:
+  dashboard:
+    port: 3100
+    artifactsDir: .agent-qa/artifacts
+    # Optional: persist dashboard state to a custom SQLite path.
+    # dbPath: .agent-qa/dashboard.sqlite
+  mcp:
+    enabled: true
+    transport: http
+    host: 127.0.0.1
+    port: 3471
+    path: /mcp
+  cache:
+    dir: .agent-qa/cache
+    ttl: 7d
+  # Accessibility checks power the W3C BAD demo test.
+  authState:
+    dir: .agent-qa/auth-states
+  vision:
+    screenshotSize: 256k
+    effectiveResolution: 768
+  accessibility:
+    enabled: true
+    standard: wcag2aa
+    runAfter: every-step
+    failOnViolation: false
+  recording:
+    enabled: true
+  logging:
+    level: warn
+
+# Committed knowledge root (optional block; these defaults apply when absent)
+# knowledge:
+#   dir: agent-qa-knowledge
+#   commitArtifacts: none
+
+# Named resource definitions (LLM configs, app targets)
+registry:
+  # Optional: local and cloud device/provider profiles.
+  # devices:
+  #   android-emu:
+  #     platform: android
+  #     transport: local
+  # providers:
+  #   browserstack:
+  #     username: ${BROWSERSTACK_USERNAME}
+  #     accessKey: ${BROWSERSTACK_ACCESS_KEY}
+  targets:
+    # Optional: add more web or mobile targets here.
+    # my-mobile:
+    #   platform: android
+    #   appPackage: com.example.app
+    #   appActivity: .MainActivity
+    #   app:
+    #     path: apps/example.apk
+    shop-example-co-uk:
+      platform: web
+      url: https://shop.example.co.uk
+
+# Execution settings (cascades: global -> suite -> test -> CLI flags)
+use:
+  browser:
+    name: chromium
+    headless: true
+    viewport:
+      width: 1280
+      height: 720
+  mobile:
+    appState: preserve
+  timeout:
+    step: 20m
+    test: 90m
+    navigation: 2m
+  planner:
+    maxSubActions: 10
+    previousStepCount: 5
+  logCapture:
+    console: true
+    network: true
+  parallel: false
+
--- /dev/null
