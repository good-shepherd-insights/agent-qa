{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "@vostride/agent-qa-arch#test": {
      "dependsOn": [
        "^build",
        "build",
        "@vostride/agent-qa-schema#build",
        "@vostride/agent-qa-agent#build",
        "@vostride/agent-qa-tools-local#build",
        "@vostride/agent-qa-core#build",
        "agent-qa#build"
      ],
      "cache": false
    },
    "lint": {},
    "lint:namespace": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
