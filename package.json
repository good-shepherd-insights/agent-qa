{
  "name": "agent-qa-monorepo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "dev": "turbo dev",
    "clean": "turbo clean",
    "validate:skills": "node skills/scripts/validate-skills.mjs",
    "validate:agents": "node scripts/validate-agent-instructions.mjs",
    "validate:publish": "node scripts/validate-publish-surface.mjs",
    "validate:tools": "pnpm --filter @vostride/agent-qa-runner exec vitest run src/tools/__tests__/validate-tools.test.ts",
    "validate:arch": "pnpm --filter @vostride/agent-qa-arch exec vitest run src/__tests__/validate-arch.test.ts src/__tests__/412-issue-slot-deleted.test.ts src/__tests__/415-no-randomness-on-gate-paths.test.ts src/__tests__/416-promotion-doors.test.ts src/__tests__/418-no-eval-writer.test.ts src/__tests__/419-one-commit-door.test.ts src/__tests__/419-one-policy-writer.test.ts --reporter=verbose src/__tests__/420-label-calibration-walls.test.ts src/__tests__/421-judge-panel-walls.test.ts src/__tests__/422-no-eval-writer.test.ts src/__tests__/430-dashboard-chat-deleted.test.ts src/__tests__/432-approval-permission-deleted.test.ts src/__tests__/433-knowledge-explorer-absent.test.ts",
    "validate:safety": "pnpm --filter @vostride/agent-qa-safety exec vitest run src/__tests__/validate-safety.test.ts",
    "validate:eval-root-hygiene": "bash scripts/413-eval-root-hygiene.sh",
    "validate:release-gate": "bash scripts/m3-release-gate.sh",
    "release:docker": "node scripts/release/docker.mjs",
    "release:docker:check": "node scripts/release/docker.mjs --check-local",
    "release:dry-run": "node scripts/release/dry-run.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "release:github": "node scripts/release/github-release.mjs",
    "gate:local": "node scripts/gate/run.mjs",
    "lint:namespace": "! grep -r '@agent-qa/' packages/ --include='*.ts' --include='*.json' --include='*.js' -l --exclude-dir=node_modules --exclude-dir=dist",
    "validate:431-discovery-imports": "node scripts/431-discovery-import-lint.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@hono/node-server": "1.19.14",
      "basic-ftp": "5.3.1",
      "brace-expansion": "5.0.7",
      "fast-xml-builder": "1.2.1",
      "hono": "4.12.28",
      "lodash": "4.18.1",
      "monaco-editor>dompurify": "3.4.11",
      "undici@7": "7.28.0",
      "webdriver>undici": "6.27.0"
    }
  },
  "devDependencies": {
    "semver": "7.7.4",
    "turbo": "~2.9.7",
    "typescript": "~6.0.3",
    "vitest": "~4.1.5"
  }
}
