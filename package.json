{
  "name": "agent-qa-monorepo",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/vostride/agent-qa#readme",
  "bugs": {
    "url": "https://github.com/vostride/agent-qa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vostride/agent-qa.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "dev": "turbo dev",
    "clean": "turbo clean",
    "validate:skills": "node skills/scripts/validate-skills.mjs",
    "validate:agents": "node scripts/validate-agent-instructions.mjs",
    "validate:publish": "node scripts/validate-publish-surface.mjs",
    "validate:tools": "pnpm --filter @vostride/agent-qa-runner exec vitest run src/tools/__tests__/validate-tools.test.ts",
    "validate:arch": "pnpm --filter @vostride/agent-qa-arch exec vitest run src/__tests__/validate-arch.test.ts src/__tests__/412-issue-slot-deleted.test.ts",
    "validate:safety": "pnpm --filter @vostride/agent-qa-safety exec vitest run src/__tests__/validate-safety.test.ts",
    "validate:router-mutation": "bash scripts/394-router-mutation.sh",
    "validate:repair-screen-mutation": "bash scripts/394-repair-screen-mutation.sh",
    "validate:apply-mutation": "bash scripts/394-apply-mutation.sh",
    "validate:apply-rollback-mutation": "bash scripts/394-apply-rollback-mutation.sh",
    "validate:fan-out-mutation": "bash scripts/394-fan-out-mutation.sh",
    "validate:fan-out-report-mutation": "bash scripts/394-fan-out-report-mutation.sh",
    "validate:funnel-mutation": "bash scripts/394-funnel-mutation.sh",
    "validate:refinement-mutation": "bash scripts/394-refinement-mutation.sh",
    "validate:run-detail-mutation": "bash scripts/405-run-detail-mutation.sh",
    "validate:debris-mutation": "bash scripts/405-debris-mutation.sh",
    "validate:failure-banner-mutation": "bash scripts/405-failure-banner-mutation.sh",
    "validate:failure-view-mutation": "bash scripts/406-failure-view-mutation.sh",
    "validate:issue-slot-mutation": "bash scripts/412-issue-slot-mutation.sh",
    "release:docker": "node scripts/release/docker.mjs",
    "release:docker:check": "node scripts/release/docker.mjs --check-local",
    "release:dry-run": "node scripts/release/dry-run.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "release:publish": "node scripts/release/publish.mjs",
    "release:github": "node scripts/release/github-release.mjs",
    "lint:namespace": "! grep -r '@agent-qa/' packages/ --include='*.ts' --include='*.json' --include='*.js' -l --exclude-dir=node_modules --exclude-dir=dist"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@hono/node-server": "1.19.14",
      "basic-ftp": "5.3.1",
      "brace-expansion": "5.0.7",
      "fast-xml-builder": "1.2.1",
      "hono": "4.12.28",
      "lodash": "4.18.1",
      "monaco-editor>dompurify": "3.4.11",
      "undici@7": "7.28.0",
      "webdriver>undici": "6.27.0"
    }
  },
  "devDependencies": {
    "semver": "7.7.4",
    "turbo": "~2.9.7",
    "typescript": "~6.0.3",
    "vitest": "~4.1.5"
  }
}
